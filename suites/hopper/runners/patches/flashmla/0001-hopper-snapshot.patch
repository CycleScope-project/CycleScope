+// T0011.b build-time scaling patch (uniform rule; see
+// suites/flashmla/SCALING.md).  The persistent split-KV decode grid is
+// dim3(num_m_block, h_k, num_sm_parts)
+// (kernels/sm90/decode/dense/splitkv_mla.cuh), so every CTA-count floor except
+// num_sm_parts is shape-derived and the stock formula sizes num_sm_parts from
+// the full device SM count.  A unified effective-SM-count cap — env
+// FLASHMLA_EFFECTIVE_SM_COUNT, falling back to the compile-time
+// FLASHMLA_EFFECTIVE_SM_COUNT_DEFAULT (0 = disabled) — replaces arch.num_sms
+// in that one formula.  One rule for every launch, no per-case branching;
+// when the cap is unset/0/>=num_sms the behavior is identical to stock.  The
+// kernel TU is untouched, so the main-kernel SASS is bit-identical pre/post
+// patch (verified statically; compile diff = api host code only).
+#ifndef FLASHMLA_EFFECTIVE_SM_COUNT_DEFAULT
+#define FLASHMLA_EFFECTIVE_SM_COUNT_DEFAULT 0
+#endif  // FLASHMLA_EFFECTIVE_SM_COUNT_DEFAULT
+namespace flashmla_scaling {
+static inline int effective_sm_count(const Arch &arch) {
+    long long cap = FLASHMLA_EFFECTIVE_SM_COUNT_DEFAULT;
+    if (const char *env = std::getenv("FLASHMLA_EFFECTIVE_SM_COUNT");
+        env != nullptr && *env != '\0') {
+        cap = std::atoll(env);
+    }
+    if (cap <= 0 || cap >= static_cast<long long>(arch.num_sms)) {
+        return arch.num_sms;
+    }
+    return static_cast<int>(cap);
+}
+}  // namespace flashmla_scaling
