 namespace deep_gemm {
 
+// Delivery measurement override for the cluster-SM rescue suite. When
+// DG_DELIVERY_FORCE_MULTICAST=1 is set in the environment, the SM90 heuristic
+// is allowed to select 2CTA cluster (TMA multicast) launches even where the
+// vendor cost model would reject them (e.g. the single-wave heuristic below).
+// Every legality check (cluster divisibility, masked-tile divisibility, block
+// sizes, swizzling, stage counts) stays active. The default build never sets
+// this env and behaves byte-identically to the vendor heuristic.
+static bool delivery_force_multicast() {
+    static const bool enabled = get_env<int>("DG_DELIVERY_FORCE_MULTICAST") == 1;
+    return enabled;
+}
+
+// DG_DELIVERY_FORCE_LAYOUT=block_m,block_n,block_k,cluster_m,cluster_n pins
+// the SM90 heuristic to exactly that layout: candidates keep every legality
+// filter below, and a pinned layout that fails them is a hard error, never
+// a silent fallback.  Env unset keeps the vendor heuristic unchanged.
+static bool delivery_force_layout(Layout& out) {
+    static std::vector<int> fields = [] {
+        std::vector<int> out;
+        const auto spec = get_env<std::string>("DG_DELIVERY_FORCE_LAYOUT");
+        std::stringstream ss(spec);
+        std::string item;
+        while (std::getline(ss, item, ','))
+            out.push_back(std::stoi(item));
+        return out;
+    }();
+    if (fields.size() != 5)
+        return false;
+    out = Layout{0, fields[0], fields[1], fields[2], fields[3], fields[4]};
+    return true;
+}
+
 struct SM90ArchSpec {
     static constexpr int smem_capacity = 232448;
 
