+#if FLASH_ATTN_3_HAS_MARKER_REGISTRY
+namespace {
+
+// Number of translation units that registered a marker setter (one per nvcc TU that
+// compiled the device_kernel override).
+int64_t fa3_marker_tu_count() {
+    return static_cast<int64_t>(cutlass::fa3_marker::registry_size());
+}
+
+// Points every TU's `static __device__` marker symbols at the shared device buffers.
+// Tensors carry uint64 values bit-packed in torch.int64 (torch has no uint64 dtype);
+// the device side reinterprets them as unsigned 64-bit.
+void fa3_marker_set_buffers(at::Tensor markers,
+                            at::Tensor grid_ids,
+                            at::Tensor grids) {
+    constexpr int64_t kMarkerMaxLaunches = 256;
+    constexpr int64_t kMarkerMaxCtas = 1024;
+    constexpr int64_t kMarkerMaxWarps = 16;
+    constexpr int64_t kMarkerFields = 7;
+    const auto check_u64 = [](const at::Tensor& t, const char* name) {
+        CHECK_DEVICE(t);
+        CHECK_CONTIGUOUS(t);
+        TORCH_CHECK(t.scalar_type() == at::kLong, name, " must have dtype torch.int64 (uint64 bit pattern)");
+    };
+    check_u64(markers, "markers");
+    check_u64(grid_ids, "grid_ids");
+    check_u64(grids, "grids");
+    TORCH_CHECK(markers.numel() == kMarkerMaxLaunches * kMarkerMaxCtas * kMarkerMaxWarps * kMarkerFields,
+                "markers must have ", kMarkerMaxLaunches * kMarkerMaxCtas * kMarkerMaxWarps * kMarkerFields, " elements");
+    TORCH_CHECK(grid_ids.numel() == kMarkerMaxLaunches, "grid_ids must have ", kMarkerMaxLaunches, " elements");
+    TORCH_CHECK(grids.numel() == kMarkerMaxLaunches, "grids must have ", kMarkerMaxLaunches, " elements");
+    TORCH_CHECK(markers.get_device() == grid_ids.get_device() && markers.get_device() == grids.get_device(),
+                "markers, grid_ids and grids must be on the same device");
+
+    // cudaMemcpyToSymbol writes the current device's copy of the symbols.
+    auto guard = make_cuda_guard_from_tensor(markers);
+    cutlass::fa3_marker::set_all_tu_buffers(
+        reinterpret_cast<unsigned long long*>(markers.data_ptr<int64_t>()),
+        reinterpret_cast<unsigned long long*>(grid_ids.data_ptr<int64_t>()),
+        reinterpret_cast<unsigned long long*>(grids.data_ptr<int64_t>()));
+}
+
+}  // namespace
+#endif  // FLASH_ATTN_3_HAS_MARKER_REGISTRY
+
